{
  "name": "driftbase-sites",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace @driftbase/web dev",
    "dev:docs": "yarn workspace @driftbase/docs dev",
    "build": "yarn workspace @driftbase/web build && yarn workspace @driftbase/docs build",
    "build:web": "yarn workspace @driftbase/web build",
    "build:docs": "yarn workspace @driftbase/docs build"
  },
  "engines": {
    "node": ">=20"
  }
}
